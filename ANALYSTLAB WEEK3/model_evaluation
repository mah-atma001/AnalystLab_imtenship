del\n","\n","for name in models.keys():\n","\n","    print(\"\\n\")\n","    print(\"=\" * 70)\n","    print(name)\n","    print(\"=\" * 70)\n","\n","    print(\n","        classification_report(\n","            y_test,\n","            predictions[name],\n","            target_names=[\n","                \"No Attrition\",\n","                \"Attrition\"\n","            ],\n","            zero_division=0\n","        )\n","    )\n","\n","# CONFUSION MATRICES\n","\n","fig, axes = plt.subplots(\n","    2,\n","    2,\n","    figsize=(12, 9)\n",")\n","\n","axes = axes.flatten()\n","\n","for ax, name in zip(axes, models.keys()):\n","\n","    # Calculate confusion matrix\n","    cm = confusion_matrix(\n","        y_test,\n","        predictions[name]\n","    )\n","\n","    # Display the matrix\n","    im = ax.imshow(cm)\n","\n","    # Add title\n","    ax.set_title(\n","        f\"Confusion Matrix - {name}\"\n","    )\n","\n","    # Axis labels\n","    ax.set_xlabel(\"Predicted Class\")\n","    ax.set_ylabel(\"Actual Class\")\n","\n","    # Tick labels\n","    ax.set_xticks(\n","        [0, 1],\n","        [\"No Attrition\", \"Attrition\"]\n","    )\n","\n","    ax.set_yticks(\n","        [0, 1],\n","        [\"No Attrition\", \"Attrition\"]\n","    )\n","\n","    # Write values inside the matrix\n","    for i in range(2):\n","        for j in range(2):\n","\n","            ax.text(\n","                j,\n","                i,\n","                cm[i, j],\n","                ha=\"center\",\n","                va=\"center\"\n","            )\n","\n","    # Add colour scale\n","    fig.colorbar(\n","        im,\n","        ax=ax\n","    )\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# ROC CURVES\n","\n","plt.figure(figsize=(9, 7))\n","\n","for name in models.keys():\n","\n","    # Calculate false-positive and true-positive rates\n","    fpr, tpr, thresholds = roc_curve(\n","        y_test,\n","        probabilities[name]\n","    )\n","\n","    # Calculate ROC-AUC\n","    auc_score = roc_auc_score(\n","        y_test,\n","        probabilities[name]\n","    )\n","\n","    # Plot ROC curve\n","    plt.plot(\n","        fpr,\n","        tpr,\n","        label=f\"{name} (AUC = {auc_score:.3f})\"\n","    )\n","\n","\n","# Random classifier baseline\n","plt.plot(\n","    [0, 1],\n","    [0, 1],\n","    linestyle=\"--\",\n","    label=\"Random Classifier\"\n",")\n","\n","plt.title(\"ROC Curves for Employee Attrition Models\")\n","\n","plt.xlabel(\"False Positive Rate\")\n","\n","plt.ylabel(\"True Positive Rate\")\n","\n","plt.legend()\n","\n","plt.grid(alpha=0.3)\n","\n","plt.tight_layout()\n","\n","plt.show()\n","\n","# PRECISION-RECALL CURVES\n","\n","plt.figure(figsize=(9, 7))\n","\n","for name in models.keys():\n","\n","    precision, recall, thresholds = precision_recall_curve(\n","        y_test,\n","        probabilities[name]\n","    )\n","\n","    plt.plot(\n","        recall,\n","        precision,\n","        label=name\n","    )\n","\n","plt.title(\n","    \"Precision-Recall Curves for Employee Attrition\"\n",")\n","\n","plt.xlabel(\"Recall\")\n","\n","plt.ylabel(\"Precision\")\n","\n","plt.legend()\n","\n","plt.grid(alpha=0.3)\n","\n","plt.tight_layout()\n","\n","plt.show()\n","\n","# MODEL PERFORMANCE COMPARISON\n","\n","comparison_plot = evaluation_df.set_index(\n","    \"Model\"\n",")[\n","    [\n","        \"Accuracy\",\n","        \"Precision\",\n","        \"Recall\",\n","        \"F1 Score\",\n","        \"ROC-AUC\"\n","    ]\n","]\n","\n","comparison_plot.plot(\n","    kind=\"bar\",\n","    figsize=(12, 7)\n",")\n","\n","plt.title(\n","    \"Comparison of Classification Models\"\n",")\n","\n","plt.xlabel(\"Machine Learning Model\")\n","\n","plt.ylabel(\"Score\")\n","\n","plt.ylim(0, 1)\n","\n","plt.xticks(\n","    rotation=20\n",")\n","\n","plt.legend(\n","    loc=\"lower right\"\n",")\n","\n","plt.grid(\n","    axis=\"y\",\n","    alpha=0.3\n",")\n","\n","plt.tight_layout()\n","\n","plt.show()\n","\n","# BEST MO